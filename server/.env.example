# Set NODE_ENV=production only behind a HTTPS reverse proxy; see SECURITY.md
NODE_ENV=development
NADI_PORT=3000
# Default localhost only; for phone testing opt in to NADI_HOST=0.0.0.0 on trusted LAN
NADI_HOST=127.0.0.1
NADI_DEMO_SEED=1
# For production: only origins you trust, comma separated; never wildcard
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Demo credential override, do not use defaults on a public deployment
NADI_SEED_PASSWORD=change-me-in-local-env
